{
  "manifest_version": 3,
  "name": "标签页录制器 · 自动分节",
  "short_name": "标签页录制器",
  "version": "1.1.11",
  "minimum_chrome_version": "116",
  "description": "录制当前标签页的画面与声音（不混入其他应用声音）。支持整门课程连播时自动按课时分节保存、自动命名归档，可后台持续录制、定时自动停止。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "标签页录制器",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "打开录制面板"
    }
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "downloads",
    "storage",
    "scripting",
    "activeTab"
  ]
}
